{
  "compilerOptions": {
    "types": ["node", "jest"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "rootDir": "./src/"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules/", "coverage/", "dist/"]
}
